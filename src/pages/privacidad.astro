---
import Base from '../layouts/Base.astro';
import { site } from '../config';
---
<Base title={`Política de privacidad | ${site.brand}`}>
  <main class="mx-auto max-w-3xl px-4 py-16 space-y-4 text-lg leading-relaxed">
    <a href="/" class="text-brand underline text-sm">← Volver</a>
    <h1 class="font-display font-black uppercase text-4xl">Política de privacidad</h1>
    <p>[Pega aquí tu política de privacidad. Debe indicar qué datos recopilas (cookies, Meta Pixel, WhatsApp), para qué los usas y cómo contactarte.]</p>
  </main>
</Base>
