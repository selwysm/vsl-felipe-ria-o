---
import Base from '../layouts/Base.astro';
import { site } from '../config';
---
<Base title={`Términos de uso | ${site.brand}`}>
  <main class="mx-auto max-w-3xl px-4 py-16 space-y-4 text-lg leading-relaxed">
    <a href="/" class="text-brand underline text-sm">← Volver</a>
    <h1 class="font-display font-black uppercase text-4xl">Términos de uso</h1>
    <p>[Pega aquí tus términos de uso. Incluye el aviso de que los resultados pueden variar y las condiciones de la garantía.]</p>
  </main>
</Base>
