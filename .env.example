# Copia este archivo como .env para desarrollo local.
# En producción, crea estas variables en Vercel → Settings → Environment Variables
# (después de cambiarlas, haz "Redeploy" para que se apliquen).
#
# El link del botón (WhatsApp), los IDs de los players de Vturb y el minuto del pitch
# de cada producto se configuran en src/products/<producto>.ts

# ID del Meta Pixel (solo el número), compartido por los 4 productos. Vacío = no se carga.
PUBLIC_META_PIXEL_ID=

# ID de tu cuenta de Vturb. Sale del código de inserción de cualquier player:
# https://scripts.converteai.net/<ACCOUNT_ID>/players/<PLAYER_ID>/v4/player.js
PUBLIC_VTURB_ACCOUNT_ID=
